import { AppCtx } from '../common/AppCtx';
import { CONTROLLER_PORT, FILE_RUNTIME_YAML } from '../common/Constants';
import { FsUtil } from '../common/FsUtil';
import { Log } from '../common/Logger';
import { VergeConfig } from '../config/VergeConfig';

/** 与内核约定的运行参数覆盖文件（和 clash-verge.yaml 同目录，由 Go 桥读取后合并） */
const FILE_OVERRIDES: string = 'verge/runtime-overrides.json';

/**
 * 用户当前选中的代理模式（rule / global / direct）。
 *
 * 为什么必须单独落一个文件：
 *   模式原本只有两条路 —— 前端 `patch_clash_mode` 直接 PATCH 给正在跑的内核，
 *   或托盘面板自己 PATCH。**两处都没有落盘**。而 TUN 开关会触发整核重载
 *   （日志里的 `config loaded by child`），重载读的是订阅原文 + overrides，
 *   里面从来没有 mode → mihomo 回落到默认 `rule`。表现就是主人看到的
 *   「点开/关闭虚拟网卡，模式自动跳到规则」。
 * 用独立小文件而不是塞进 clash-config.json：那个文件是「合并写」，
 * 托盘面板是另一个进程，并发合并会互相覆盖；单值文件没这个问题。
 */
const FILE_CLASH_MODE: string = 'verge/clash-mode.txt';

/**
 * 生成交给内核的运行时配置。
 *
 * ⚠️ 分工修订（2026-11-13 复核轮）：**不在 ArkTS 侧做 YAML 文本拼接**。
 * 订阅原文里本来就有 `mixed-port` / `external-controller` / `dns` 等字段，
 * 如果我们在前面再拼一份 head，YAML 会出现重复键，`yaml.v3` 解析时直接报错
 * （mapping key already defined）→ 内核起不来，表现是"点了连接但永远连不上"。
 *
 * 所以：
 *   - `clash-verge.yaml` = 订阅原文（一字不改），没有订阅时用最小可用配置
 *   - `runtime-overrides.json` = 我们自己要强制生效的顶层字段
 *   - 合并、dns 兜底、tun 注入，全部交给 Go 桥（`clash_core_load` / `clash_core_start_tun`）
 */
export class RuntimeConfig {
  /**
   * 上一次 `write()` 是否**真的**改了磁盘内容。
   *
   * 用途：`applyRuntime()` 每次都会调用 write，而前端在几秒内会连着触发好几次
   * （实测 17:58:03–05 连写 4 次，内容一模一样）。内核常驻之后，每次 reload 都是
   * 整核重启（监听器全断、现有连接被踢），所以内容没变时必须能跳过。
   */
  static lastChanged: boolean = true;

  /** 读已保存的模式；非法/缺失返回空串 */
  static readMode(): string {
    const raw = FsUtil.readText(AppCtx.path(FILE_CLASH_MODE)).trim();
    if (raw === 'rule' || raw === 'global' || raw === 'direct') {
      return raw;
    }
    return '';
  }

  /** 落盘当前模式（TUN 重载时靠它把模式带回去） */
  static writeMode(mode: string): void {
    if (mode !== 'rule' && mode !== 'global' && mode !== 'direct') {
      return;
    }
    if (RuntimeConfig.readMode() === mode) {
      return;
    }
    FsUtil.writeText(AppCtx.path(FILE_CLASH_MODE), mode);
    Log.i('RuntimeConfig', `mode saved: ${mode}`);
  }

  /** 没有订阅时用最小可用配置，保证内核能起来（direct 模式，可用于冒烟） */
  static minimal(secret: string, verge: VergeConfig): string {
    const lines: string[] = [];
    lines.push('# generated by Clash Verge OHOS (no profile)');
    const savedMode = RuntimeConfig.readMode();
    lines.push(`mode: ${savedMode.length > 0 ? savedMode : 'rule'}`);
    lines.push('proxies: []');
    lines.push('proxy-groups: []');
    lines.push('rules:');
    lines.push('  - MATCH,DIRECT');
    return lines.join('\n');
  }

  /**
   * 用户在「Clash 设置」里改过的项（`patch_clash_config` 落的盘）。
   *
   * 为什么要参与合并：`patch_clash_config` 只 PATCH 了正在跑的内核，
   * 而内核现在常驻、切订阅/改配置都会重载 —— 不把这份落盘内容合并回去，
   * 用户改过的设置（tcp-concurrent / unified-delay / sniffer …）会在重载后静默复原。
   */
  private static savedClashConfig(): Record<string, Object | null> {
    const raw = FsUtil.readText(AppCtx.path('verge/clash-config.json'));
    if (raw.length === 0) {
      return {};
    }
    try {
      return JSON.parse(raw) as Record<string, Object | null>;
    } catch (e) {
      Log.w('RuntimeConfig', `clash-config.json parse failed: ${Log.err(e as Object)}`);
      return {};
    }
  }

  /** 我们强制生效的顶层字段（覆盖订阅里的同名项） */
  private static overrides(secret: string, verge: VergeConfig): Record<string, Object | null> {
    const cors: Record<string, Object | null> = {};
    const allowOrigins: string[] = ['*'];
    cors['allow-origins'] = allowOrigins;
    cors['allow-private-network'] = true;

    const out: Record<string, Object | null> = {};
    // 先放用户改过、需要持久生效的项（优先级低于下面几条强制项）
    const saved = RuntimeConfig.savedClashConfig();
    const savedKeys = Object.keys(saved);
    for (let i = 0; i < savedKeys.length; i++) {
      out[savedKeys[i]] = saved[savedKeys[i]];
    }
    // 模式：必须在 overrides 里强制一次。订阅原文可能写 `mode: rule`，
    // 不加这条，重载后用户的 global/direct 会被订阅冲掉。
    const mode = RuntimeConfig.readMode();
    if (mode.length > 0) {
      out['mode'] = mode;
    }
    out['mixed-port'] = verge.getNumber('verge_mixed_port', 7890);
    // 与上游一致：socks/http 由开关控制（关闭时端口写 0，mihomo 不监听）；
    // redir/tproxy 在鸿蒙没有 iptables 支持，始终关掉，避免内核启动时报错。
    out['socks-port'] = verge.getBool('verge_socks_enabled', false)
      ? verge.getNumber('verge_socks_port', 7891) : 0;
    out['port'] = verge.getBool('verge_http_enabled', false)
      ? verge.getNumber('verge_port', 7897) : 0;
    out['redir-port'] = 0;
    out['tproxy-port'] = 0;
    out['allow-lan'] = false;
    out['bind-address'] = '127.0.0.1';
    out['log-level'] = 'info';
    out['external-controller'] = `127.0.0.1:${CONTROLLER_PORT}`;
    out['secret'] = secret;
    out['external-controller-cors'] = cors;
    // TUN 段：start_tun 会在 mergeTun 里强制这些值，这里提前写进 base config，
    // 让 /configs 与设置弹窗显示的值和**实际生效值**一致（否则弹窗显示 MTU 1500/mips? 不一致）。
    const tun: Record<string, Object | null> = {};
    tun['enable'] = false;
    tun['stack'] = 'mips';
    tun['mtu'] = 1400;
    tun['auto-route'] = false;
    tun['auto-detect-interface'] = false;
    const hijack: string[] = ['any:53'];
    tun['dns-hijack'] = hijack;
    out['tun'] = tun;
    // geo 数据随安装包内置（CoreHost.provisionGeo 释放到 <home>），这里只保证
    // 万一文件缺失、或用户想更新时**不要**去 GitHub（真机不可达，会让启动卡 30s+）。
    out['geo-auto-update'] = false;
    // 统一用内置的 mmdb（GeoIP.dat 有 16MB，不随包发）；订阅里若写了 geodata-mode:true 也压回 mmdb
    out['geodata-mode'] = false;
    const geox: Record<string, string> = {};
    geox['geoip'] = 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat';
    geox['geosite'] = 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat';
    geox['mmdb'] = 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb';
    out['geox-url'] = geox;
    return out;
  }

  /**
   * 订阅如果没有 MATCH 兜底，mihomo 对“没有命中任何规则”的连接会直接失败。
   * TUN 会把系统所有流量（包括不在订阅规则里的国内 API）交给它，表现就是
   * “一开 VPN 就连不上服务”。这里补一条 MATCH,DIRECT：已知的代理规则优先，
   * 未命中的走直连，至少不会把国内请求丢进黑洞。
   */
  private static ensureFinalRule(text: string): string {
    if (text.indexOf('MATCH,') >= 0) {
      return text;
    }
    const rulesAt = text.indexOf('\nrules:');
    if (rulesAt < 0) {
      return text;
    }
    // 找 rules 段之后第一个顶格字段（或文件末尾），把兜底规则插在 rules 段末尾
    let lineEnd = text.indexOf('\n', rulesAt + 1);
    let insertAt = text.length;
    while (lineEnd >= 0) {
      const nextEnd = text.indexOf('\n', lineEnd + 1);
      const line = text.substring(lineEnd + 1, nextEnd < 0 ? text.length : nextEnd);
      if (line.length > 0 && line.charAt(0) !== ' ' && line.charAt(0) !== '\t' && line.charAt(0) !== '#') {
        insertAt = lineEnd + 1;
        break;
      }
      lineEnd = nextEnd;
    }
    return text.substring(0, insertAt) + '  - MATCH,DIRECT\n' + text.substring(insertAt);
  }

  /**
   * WorkBuddy / DeepSeek / 腾讯云等国内服务不在订阅规则里时，会落到最后的
   * MATCH,良心云。TUN 一开就把这些连接送去节点，节点侧常被断/超时，表现就是
   * “国内 API 连不上、WorkBuddy 掉线”。这里在 MATCH 前补一组直连域名。
   */
  private static ensureDomesticBypass(text: string): string {
    const domains: string[] = [
      'workbuddy.cn',
      'workbuddy.link',
      'workbuddy.agentos-worker.net',
      'deepseek.com',
      'tencent.com',
      'qq.com',
      'aliyuncs.com',
      'volces.com',
    ];
    // 模型/协作服务有时直接连 IP（fake-ip 下 GEOIP,CN 不生效）：
    // 8.140.217.18 是 DevEco/模型侧实际 ESTABLISHED 的阿里云出口。
    const ipRules: string[] = [
      'IP-CIDR,8.140.217.0/24,DIRECT,no-resolve',
      'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve',
      'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve',
      'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve',
    ];
    const matchIdx = text.lastIndexOf('MATCH,');
    if (matchIdx < 0) {
      return text;
    }
    const lineStart = text.lastIndexOf('\n', matchIdx) + 1;
    const lineEnd = text.indexOf('\n', matchIdx);
    const line = text.substring(lineStart, lineEnd < 0 ? text.length : lineEnd);
    const dash = line.indexOf('-');
    const leading = dash >= 0 ? line.substring(0, dash + 1) : '    -';
    let block = '';
    for (let i = 0; i < domains.length; i++) {
      const rule = `DOMAIN-SUFFIX,${domains[i]},DIRECT`;
      if (text.indexOf(rule) < 0) {
        block += `${leading} ${rule}\n`;
      }
    }
    for (let i = 0; i < ipRules.length; i++) {
      const rule = ipRules[i];
      if (text.indexOf(rule) < 0) {
        block += `${leading} ${rule}\n`;
      }
    }
    if (block.length === 0) {
      return text;
    }
    return text.substring(0, lineStart) + block + text.substring(lineStart);
  }

  /**
   * 写运行时配置，返回 `clash-verge.yaml` 的绝对路径。
   * 同时写 `runtime-overrides.json`（内核启动时读取并覆盖同名顶层字段）。
   */
  static write(secret: string, verge: VergeConfig, profileContent: string): string {
    const path = AppCtx.path(FILE_RUNTIME_YAML);
    let text = profileContent.trim();
    if (text.length === 0) {
      text = RuntimeConfig.minimal(secret, verge);
    }
    text = RuntimeConfig.ensureFinalRule(text);
    text = RuntimeConfig.ensureDomesticBypass(text);
    const overridesPath = AppCtx.path(FILE_OVERRIDES);
    const overridesText = JSON.stringify(RuntimeConfig.overrides(secret, verge));

    const oldText = FsUtil.readText(path);
    const oldOverrides = FsUtil.readText(overridesPath);
    const changed = oldText !== text || oldOverrides !== overridesText;
    RuntimeConfig.lastChanged = changed;
    if (!changed) {
      // 内容一致：不写盘、也不该让调用方去重载内核
      return path;
    }
    FsUtil.writeText(path, text);
    FsUtil.writeText(overridesPath, overridesText);
    Log.i('RuntimeConfig', `written ${path} (${text.length} bytes) + overrides`);
    return path;
  }
}
